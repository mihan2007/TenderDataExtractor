# Copy to config.env (git-ignored) or set as environment variables.

# Telegram bot token from @BotFather
BOT_TOKEN=
# Password that new team members enter to get access
BOT_PASSWORD=

# NocoDB - same base as tools/nocodb_client.py (see config.json in the project root)
NOCODB_URL=https://app.nocodb.com
NOCODB_TOKEN=
NOCODB_BASE_ID=
NOCODB_REGISTRY_TABLE_ID=

# DeepSeek - without a key, parsing of texts/files is disabled (buttons still work)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Currency all prices are stored in (must be published by the ECB: EUR, USD, GBP, CHF, ...)
BASE_CURRENCY=EUR
# Prefix of internal tender numbers (same as config.json -> internal_number.prefix)
INTERNAL_PREFIX=T-
# IANA time zone used for comment timestamps and topic names
BOT_TIMEZONE=UTC
# Your own company names, so the model never mistakes the buyer for the supplier
OUR_COMPANIES=
# 1 = write parsed prices immediately (with an Undo button), 0 = ask first
AUTO_SAVE=1
# 1 = one topic per specification in each user's private chat (needs Threaded Mode in @BotFather)
PRIVATE_TOPICS=1
